<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="400.0"
        prefWidth="600.0"
        spacing="16.0"
        style="-fx-background-color: #ffffff; -fx-padding: 28 32 28 32;"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="screens.manageAdmins.ManageAdminsController">

    <!-- Header Row: Title + Add Button -->
    <HBox alignment="CENTER_LEFT">
        <Label text="Manage Admins"
               style="-fx-font-family: 'Arial Black'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111111;">
        </Label>

        <!-- Spacer -->
        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="addAdminButton"
                text="+ Add Admin"
                onAction="#handleAddAdmin"
                style="
                    -fx-background-color: linear-gradient(to right, #38b6ff, #38d9a9);
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 50px;
                    -fx-padding: 10 24 10 24;
                    -fx-cursor: hand;
                    -fx-effect: dropshadow(gaussian, rgba(56,182,255,0.35), 8, 0, 0, 3);
                "/>
    </HBox>

    <!-- Gradient Card with ListView -->
    <StackPane
            VBox.vgrow="ALWAYS"
            style="
            -fx-background-color: linear-gradient(to right, #38b6ff, #38d9a9);
            -fx-background-radius: 20px;
            -fx-padding: 14;
            -fx-effect: dropshadow(gaussian, rgba(56,182,255,0.25), 16, 0, 0, 4);
        ">

        <ListView fx:id="adminsListView"
                  style="
                      -fx-background-color: transparent;
                      -fx-background-insets: 0;
                      -fx-padding: 0;
                      -fx-border-color: transparent;
                  "/>
    </StackPane>

</VBox>
