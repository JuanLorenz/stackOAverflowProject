<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.manageAdmins.ManageAdminsController">
    <children>

        <ImageView fx:id="btnMenu" fitHeight="28.0" fitWidth="41.0" onMouseClicked="#handleMenu" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../images/icon-burger-green.png" />
            </image>
            <HBox.margin>
                <Insets left="20.0" top="26.0" />
            </HBox.margin>
        </ImageView>
        <VBox spacing="12.0" HBox.hgrow="ALWAYS" style="-fx-background-color: #ffffff; -fx-padding: 24 32 28 32;">

            <stylesheets>
                <URL value="@manageAdmins.css" />
            </stylesheets>

            <HBox alignment="CENTER_LEFT" spacing="12.0">

                <Label style="-fx-font-family: 'Arial Black'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #111111;" styleClass="welcome-label" text="Welcome, Admin!" />

            </HBox>

            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" styleClass="section-label" text="Manage Admins" />

            <HBox alignment="CENTER_LEFT" spacing="12.0">

                <TextField fx:id="txtfldSearchField" onKeyReleased="#handleSearch" promptText="Search" style="-fx-pref-width: 200px; -fx-pref-height: 34px; -fx-background-color: #f5f5f5; -fx-background-radius: 50px; -fx-border-color: #dddddd; -fx-border-radius: 50px; -fx-border-width: 1px; -fx-padding: 6 16 6 16; -fx-font-size: 13px; -fx-prompt-text-fill: #aaaaaa;" styleClass="search-field" HBox.hgrow="NEVER" />

                <Region HBox.hgrow="ALWAYS" />

                <Button fx:id="addAdminButton" onAction="#handleAddAdmin" style="-fx-background-color: linear-gradient(to right, #38b6ff, #38d9a9); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 50px; -fx-padding: 10 24 10 24; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(56,182,255,0.35), 8, 0, 0, 3);" styleClass="add-admin-button" text="+ Add Admin" />
            </HBox>

            <StackPane VBox.vgrow="ALWAYS" maxWidth="Infinity" maxHeight="Infinity" style="-fx-background-color: linear-gradient(to right, #38b6ff, #38d9a9); -fx-background-radius: 20px; -fx-padding: 14; -fx-effect: dropshadow(gaussian, rgba(56,182,255,0.25), 16, 0, 0, 4);" styleClass="gradient-card">

                <ListView fx:id="adminsListView" maxWidth="Infinity" maxHeight="Infinity" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-border-color: transparent; -fx-focus-color: transparent;-fx-faint-focus-color: transparent;" styleClass="admins-list-view" />

                <Label fx:id="lblEmptyAdminList" style="-fx-font-family: 'Arial Black'; -fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" styleClass="empty-label" text="No other Admins for now..." />

            </StackPane>

        </VBox>
    </children>
</HBox>
