<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox fillWidth="true" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.settings.SettingsController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <children>

        <!-- Personal Information Section -->
        <HBox spacing="50.0" VBox.vgrow="NEVER">
            <children>

                <!-- Left: Name + Email fields -->
                <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Personal Information" />

                        <!-- Name -->
                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Name" />
                            <TextField fx:id="txtfldName" maxWidth="Infinity" prefHeight="48.0" promptText="Enter your name" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 8 18 8 18; -fx-font-size: 15px; -fx-text-fill: #222222; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" />
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="6.0">
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Email" />
                            <TextField fx:id="txtfldEmail" maxWidth="Infinity" prefHeight="48.0" promptText="Enter your email account" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 8 18 8 18; -fx-font-size: 15px; -fx-text-fill: #222222; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" />
                        </VBox>
                    </children>
                </VBox>

                <!-- Spacer -->
                <Region maxWidth="100.0" minWidth="100.0" prefWidth="100.0" />

                <!-- Right: Avatar -->
                <VBox alignment="TOP_CENTER" maxWidth="300.0" minWidth="280.0" prefWidth="300.0" spacing="20.0" HBox.hgrow="NEVER">
                    <children>
                        <StackPane minHeight="210.0" minWidth="210.0" prefHeight="210.0" prefWidth="210.0">
                            <children>
                                <ImageView fx:id="imgProfile" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../media/profiles/placeholder-profile.png" />
                                    </image>
                                    <clip>
                                        <Circle centerX="100.0" centerY="100.0" radius="100.0" />
                                    </clip>
                                </ImageView>
                                <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="BOTTOM_CENTER">
                                    <image>
                                        <Image url="@../../media/icons/icon-camera.png" />
                                    </image>
                                    <StackPane.margin>
                                        <Insets bottom="6.0" left="120.0" />
                                    </StackPane.margin>
                                </ImageView>
                            </children>
                        </StackPane>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button onAction="#onClickUploadNewProfile" prefHeight="44.0" prefWidth="135.0" style="-fx-background-color: #3ecfb2; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" text="Upload New" />
                                <Button onAction="#onClickDeleteProfile" prefHeight="44.0" prefWidth="135.0" style="-fx-background-color: #aaaaaa; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" text="Delete Avatar" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
         <VBox.margin>
            <Insets top="50.0" />
         </VBox.margin>
        </HBox>

        <!-- Security Section -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <VBox.margin>
                <Insets top="30.0" />
            </VBox.margin>
            <children>
                <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Security" />

                <HBox alignment="BOTTOM_LEFT" spacing="30.0">
                    <children>
                        <!-- New Password -->
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Enter Password" />
                            <PasswordField fx:id="txtfldNewPassword" maxWidth="Infinity" prefHeight="48.0" promptText="Enter New Password" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 8 18 8 18; -fx-font-size: 15px; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" />
                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Confirm Password" />
                            <PasswordField fx:id="txtfldConfirmPassword" maxWidth="Infinity" prefHeight="48.0" promptText="Confirm Password" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 25; -fx-background-radius: 25; -fx-padding: 8 18 8 18; -fx-font-size: 15px; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" />
                        </VBox>

                        <!-- Spacer -->
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Save Button Container -->
                        <VBox alignment="BOTTOM_CENTER" spacing="10.0">
                            <Button fx:id="btnSaveChanges" onAction="#onClickSaveChanges" prefHeight="48.0" prefWidth="180.0" style="-fx-background-color: #42b8e8; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" text="Save Changes" />
                        </VBox>
                    </children>
                </HBox>
            <HBox alignment="CENTER" prefHeight="80.0" prefWidth="200.0">
               <children>
                         <Label fx:id="lblError" alignment="CENTER" style="-fx-font-size: 18px; -fx-font-weight: bold;" textFill="RED">
                     <HBox.margin>
                        <Insets />
                     </HBox.margin></Label>
               </children>
            </HBox>
            </children>
        </VBox>

    </children>
</VBox>
