<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox fillWidth="true" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.settings.SettingsController">

    <padding>
        <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
    </padding>

    <children>

        <!-- Title -->
        <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #222222;">

            <VBox.margin>
                <Insets bottom="10.0" top="10.0" />
            </VBox.margin>

        </Label>

        <!-- Personal Information Section -->
        <HBox spacing="40.0" VBox.vgrow="ALWAYS">

            <children>

                <!-- Left: Name + Email fields -->
                <VBox spacing="0.0" HBox.hgrow="ALWAYS">

                    <children>

                        <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Personal Information">

                            <VBox.margin>
                                <Insets bottom="8.0" top="10.0" />
                            </VBox.margin>

                        </Label>

                        <!-- Name -->
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Name">

                            <VBox.margin>
                                <Insets bottom="4.0" left="4.0" top="4.0" />
                            </VBox.margin>

                        </Label>

                        <TextField fx:id="txtfldName" maxWidth="Infinity" prefHeight="38.0" promptText="Enter your name" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-font-size: 13px; -fx-text-fill: #222222; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" HBox.hgrow="ALWAYS">

                            <VBox.margin>
                                <Insets bottom="10.0" />
                            </VBox.margin>

                        </TextField>

                        <!-- Email -->
                        <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Email">

                            <VBox.margin>
                                <Insets bottom="4.0" left="4.0" top="4.0" />
                            </VBox.margin>

                        </Label>

                        <TextField fx:id="txtfldEmail" maxWidth="Infinity" prefHeight="38.0" promptText="Enter your email account" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-font-size: 13px; -fx-text-fill: #222222; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />

                    </children>

                </VBox>

                <!-- Right: Avatar -->
                <VBox alignment="TOP_CENTER" maxWidth="300.0" minWidth="240.0" prefWidth="260.0" spacing="14.0" HBox.hgrow="NEVER">

                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>

                    <children>

                        <!-- Avatar -->
                        <StackPane minHeight="180.0" minWidth="180.0" prefHeight="180.0" prefWidth="180.0">

                            <children>

                                <!-- Profile Image -->
                                <ImageView fx:id="imgProfile" fitHeight="170.0" fitWidth="170.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="CENTER">

                                    <image>
                                        <Image url="@../../media/profiles/placeholder-profile.png" />
                                    </image>

                                    <clip>
                                        <Circle centerX="85.0" centerY="85.0" radius="85.0" />
                                    </clip>

                                </ImageView>

                                <!-- Camera Icon -->
                                <ImageView fitHeight="52.0" fitWidth="52.0" pickOnBounds="true" preserveRatio="true" StackPane.alignment="BOTTOM_CENTER">

                                    <image>
                                        <Image url="@../../media/icons/icon-camera.png" />
                                    </image>

                                    <StackPane.margin>
                                        <Insets bottom="6.0" left="100.0" />
                                    </StackPane.margin>

                                </ImageView>

                            </children>

                        </StackPane>

                        <!-- Buttons -->
                        <HBox alignment="CENTER" spacing="10.0">

                            <children>

                                <Button onAction="#onClickUploadNewProfile" prefHeight="36.0" prefWidth="115.0" style="-fx-background-color: #3ecfb2; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Upload New" />

                                <Button onAction="#onClickDeleteProfile" prefHeight="36.0" prefWidth="118.0" style="-fx-background-color: #aaaaaa; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Delete Avatar" />

                            </children>

                        </HBox>

                    </children>

                </VBox>

            </children>

        </HBox>

        <!-- Password Section -->
        <VBox spacing="0.0">

            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>

            <children>

                <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Password">

                    <VBox.margin>
                        <Insets bottom="8.0" />
                    </VBox.margin>

                </Label>

                <HBox alignment="CENTER_LEFT" spacing="20.0">

                    <children>

                        <!-- New Password -->
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">

                            <children>

                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="New Password">

                                    <VBox.margin>
                                        <Insets left="4.0" />
                                    </VBox.margin>

                                </Label>

                                <PasswordField fx:id="txtfldNewPassword" maxWidth="Infinity" prefHeight="38.0" promptText="Enter New Password" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-font-size: 13px; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />

                            </children>

                        </VBox>

                        <!-- Confirm Password -->
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">

                            <children>

                                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Confirm Password">

                                    <VBox.margin>
                                        <Insets left="4.0" />
                                    </VBox.margin>

                                </Label>

                                <PasswordField fx:id="txtfldConfirmPassword" maxWidth="Infinity" prefHeight="38.0" promptText="Confirm Password" style="-fx-background-color: transparent; -fx-border-color: #3ecfb2; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 6 14 6 14; -fx-font-size: 13px; -fx-prompt-text-fill: #aaaaaa; -fx-border-width: 2;" HBox.hgrow="ALWAYS" />

                            </children>

                        </VBox>

                    </children>

                </HBox>

            </children>

        </VBox>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS" />

        <!-- Save Changes -->
        <HBox alignment="CENTER_RIGHT">

            <VBox.margin>
                <Insets top="24.0" />
            </VBox.margin>

            <children>

                <VBox alignment="TOP_CENTER">

                    <children>

                        <Button fx:id="btnSaveChanges" onAction="#onClickSaveChanges" prefHeight="38.0" prefWidth="140.0" style="-fx-background-color: #42b8e8; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 20; -fx-cursor: hand;" text="Save Changes" />

                        <Label fx:id="lblError" style="-fx-font-size: 12px; -fx-font-weight: bold;" textFill="RED">

                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>

                        </Label>

                    </children>

                </VBox>

            </children>

        </HBox>

    </children>

</VBox>
