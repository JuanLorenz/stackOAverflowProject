<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox fx:id="root" alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" spacing="20.0" styleClass="popup-container" stylesheets="@BorrowEquipmentPopupStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.popup.BorrowEquipmentPopupController">

   <padding>
      <Insets bottom="30.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <children>
       <HBox alignment="CENTER">
           <children>
               <HBox HBox.hgrow="ALWAYS">
                   <HBox.margin>
                       <Insets left="15.0" />
                   </HBox.margin></HBox>
               <!-- Added styleClass="popup-header" -->
               <Label fx:id="lblEquipmentName" styleClass="popup-header">
                   <font>
                       <Font name="System Bold" size="24.0" />
                   </font>
               </Label>
               <HBox HBox.hgrow="ALWAYS" />
               <!-- Added styleClass="popup-close-button" -->
               <Button fx:id="buttonX" mnemonicParsing="false" onAction="#onXClicked" styleClass="back-button" text="X">
                   <HBox.margin>
                       <Insets right="15.0" />
                   </HBox.margin>
               </Button>
           </children>
           <VBox.margin>
               <Insets left="30.0" right="15.0" top="30.0" />
           </VBox.margin>
       </HBox>

      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <HBox HBox.hgrow="ALWAYS" />
            <!-- Image Section -->
            <StackPane styleClass="image-container">
               <children>
                  <ImageView fx:id="ivEquipmentImage" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true" />
               </children>
            </StackPane>

            <!-- Details Section -->
            <VBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="lblModelNo" styleClass="info-label" text="Model no: xxxxx" />
                  <Label fx:id="lblSerialNo" styleClass="info-label" text="Serial no: xxxxx" />
                  <Label fx:id="lblCategory" styleClass="info-label" text="Category: PE" />
                  <Label fx:id="lblCondition" styleClass="info-label" text="Condition: xxx" />
                  <Label fx:id="lblAvailableQty" styleClass="info-label" text="Available Qty: n" />
               </children>
               <HBox.margin>
                  <Insets right="30.0" />
               </HBox.margin>
            </VBox>
         </children>
         <VBox.margin>
            <Insets left="30.0" right="30.0" top="15.0" />
         </VBox.margin>
      </HBox>

      <StackPane alignment="BOTTOM_RIGHT">
         <children>
            <Button fx:id="btnBorrow" onAction="#handleBorrow" prefHeight="40.0" prefWidth="120.0" styleClass="borrow-button" text="Borrow">
               <StackPane.margin>
                  <Insets bottom="15.0" />
               </StackPane.margin>
            </Button>
         </children>
         <VBox.margin>
            <Insets right="30.0" />
         </VBox.margin>
      </StackPane>
   </children>
</VBox>
