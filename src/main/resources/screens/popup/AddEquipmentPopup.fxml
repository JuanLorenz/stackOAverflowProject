<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<Pane fx:id="addEquipmentPopUp" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" stylesheets="@AddEquipmentPopupStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.popup.AddEquipmentPopupController">
    <children>
        <VBox alignment="CENTER" layoutX="25.0" layoutY="10.0" prefWidth="600.0" styleClass="popup-container">
            <children>
                <HBox alignment="CENTER">
                    <children>
                        <HBox HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin></HBox>
                        <Label alignment="CENTER" styleClass="popup-header" text="Add Equipment" />
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button fx:id="buttonX" mnemonicParsing="false" onAction="#onXClicked" styleClass="popup-close-button" text="X">
                            <HBox.margin>
                                <Insets />
                            </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets left="30.0" right="15.0" top="15.0" />
                    </VBox.margin>
                </HBox>

                <HBox prefHeight="300.0" prefWidth="600.0">
                    <children>
                        <VBox alignment="CENTER" prefHeight="200.0" prefWidth="250.0">
                            <children>
                        <VBox VBox.vgrow="ALWAYS" />
                                <ImageView fx:id="equipmentImage" fitHeight="219.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true">
                                    <VBox.margin>
                                        <Insets bottom="10.0" top="15.0" />
                                    </VBox.margin>
                                </ImageView>
                        <VBox VBox.vgrow="ALWAYS" />
                                <Button fx:id="uploadImage" mnemonicParsing="false" onAction="#onUploadImgClicked" styleClass="popup-img-button" text="Upload Image" />
                            </children>
                            <HBox.margin>
                                <Insets left="20.0" right="20.0" />
                            </HBox.margin>
                        </VBox>

                        <VBox alignment="CENTER" prefHeight="300.0" prefWidth="300.0" spacing="15.0">
                            <children>
                                <TextField fx:id="equipmentName" promptText="Equipment Name" styleClass="popup-text-field" />
                                <TextField fx:id="equipmentCategory" promptText="Category" styleClass="popup-text-field" />
                                <TextField fx:id="equipmentModelNo" promptText="Model No." styleClass="popup-text-field" />
                                <TextField fx:id="equipmentSerialNo" promptText="Serial No." styleClass="popup-text-field" />
                                <TextField fx:id="equipmentCondition" promptText="Condition" styleClass="popup-text-field" />
                                <TextField fx:id="equipmentTotalQty" promptText="Total Quantity" styleClass="popup-text-field" />
                            </children>
                            <padding>
                                <Insets left="15.0" right="15.0" />
                            </padding>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets top="20.0" />
                    </VBox.margin>
                </HBox>

                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Button fx:id="add" mnemonicParsing="false" onAction="#onAddClicked" prefWidth="120.0" styleClass="popup-confirm-button" text="Add">
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </Button>
                    </children>
               <VBox.margin>
                  <Insets bottom="15.0" top="30.0" />
               </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</Pane>
