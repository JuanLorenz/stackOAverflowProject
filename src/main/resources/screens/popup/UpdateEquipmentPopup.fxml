<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane fx:id="updateEquipmentPopUp" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="600.0" stylesheets="@UpdateEquipmentPopupStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.popup.UpdateEquipmentPopupController">
    <children>
        <!-- Added styleClass="popup-container" and removed inline background-color -->
        <VBox alignment="CENTER" layoutX="25.0" layoutY="10.0" prefWidth="600.0" styleClass="popup-container">
            <children>
                <HBox alignment="CENTER">
                    <children>
                        <HBox HBox.hgrow="ALWAYS">
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin></HBox>
                        <!-- Added styleClass="popup-header" -->
                        <Label fx:id="labelEquipmentName" styleClass="popup-header">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <HBox HBox.hgrow="ALWAYS" />
                        <!-- Added styleClass="popup-close-button" -->
                        <Button fx:id="buttonX" mnemonicParsing="false" onAction="#onXClicked" styleClass="popup-close-button" text="X">
                            <HBox.margin>
                                <Insets right="15.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets left="30.0" right="15.0" top="30.0" />
                    </VBox.margin>
                </HBox>

                <HBox>
                    <children>
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <children>
                                <StackPane minWidth="200.0" prefWidth="200.0" alignment="CENTER">
                                    <ImageView fx:id="EquipmentImage" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                                        <VBox.margin>
                                            <Insets bottom="10.0" top="15.0" />
                                        </VBox.margin>
                                    </ImageView>
                                </StackPane>
                                <HBox alignment="CENTER">
                                    <children>
                                        <!-- Added styleClass="popup-img-button" -->
                                        <Button fx:id="buttonUpdateImage" mnemonicParsing="false" onAction="#onUpdateImgClicked" styleClass="popup-img-button" text="Update Image" />
                                    </children>
                                </HBox>
                            </children>
                            <HBox.margin>
                                <Insets left="30.0" />
                            </HBox.margin>
                        </VBox>

                        <HBox HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER_LEFT" maxHeight="500.0" maxWidth="300.0" prefHeight="218.0" prefWidth="434.0" HBox.hgrow="ALWAYS">
                            <children>
                                <!-- Added styleClass="info-value-label" for DB data -->
                                <Label fx:id="labelEquipmentModelNo" styleClass="info-value-label">
                                    <VBox.margin> <Insets bottom="10.0" left="15.0" /> </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentSerialNo" styleClass="info-value-label">
                                    <VBox.margin> <Insets bottom="10.0" left="15.0" /> </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentCategory" styleClass="info-value-label">
                                    <VBox.margin> <Insets bottom="10.0" left="15.0" /> </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentCondition" styleClass="info-value-label">
                                    <VBox.margin> <Insets bottom="10.0" left="15.0" /> </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentAvailable" styleClass="info-value-label">
                                    <VBox.margin> <Insets bottom="20.0" left="15.0" /> </VBox.margin>
                                </Label>

                                <!-- Added styleClass="info-header-label" -->
                                <Label styleClass="info-header-label" text="Updateable: ">
                                    <VBox.margin> <Insets bottom="10.0" left="15.0" /> </VBox.margin>
                                </Label>

                                <!-- Added styleClass="popup-text-field" -->
                                <TextField fx:id="updateEquipmentCondition" promptText="Condition" styleClass="popup-text-field">
                                    <VBox.margin> <Insets bottom="15.0" left="15.0" right="15.0" /> </VBox.margin>
                                </TextField>
                                <TextField fx:id="updateEquipmentTotalQty" promptText="Total Quantity" styleClass="popup-text-field">
                                    <VBox.margin> <Insets left="15.0" right="15.0" /> </VBox.margin>
                                </TextField>
                            </children>
                            <HBox.margin> <Insets right="30.0" /> </HBox.margin>
                            <padding> <Insets left="20.0" right="20.0" /> </padding>
                        </VBox>
                    </children>
                    <VBox.margin> <Insets top="30.0" /> </VBox.margin>
                </HBox>

                <HBox alignment="BOTTOM_RIGHT">
                    <children>
                        <!-- Added styleClass="popup-confirm-button" -->
                        <Button fx:id="buttonUpdate" mnemonicParsing="false" onAction="#onUpdateClicked" styleClass="popup-confirm-button" text="Update">
                            <HBox.margin> <Insets right="30.0" /> </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin> <Insets bottom="20.0" top="30.0" /> </VBox.margin>
                </HBox>
            </children>
            <padding> <Insets top="30.0" /> </padding>
        </VBox>
    </children>
</Pane>
