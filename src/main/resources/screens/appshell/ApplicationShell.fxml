<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<!-- The Root is now a StackPane -->

<StackPane fx:id="shellRoot" maxHeight="900.0" maxWidth="1600.0" minHeight="600.0" minWidth="1000.0" prefHeight="900.0" prefWidth="1600.0" stylesheets="@ApplicationShellStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.appshell.ApplicationShellController">



    <!-- LAYER 1: THE ACTUAL APP (Sidebar + Content) -->
    <BorderPane fx:id="shellPane" stylesheets="@ApplicationShellStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
        <left>
            <VBox fx:id="sidebar" prefWidth="240.0" styleClass="sidebar" viewOrder="-1">
                <VBox fx:id="sidebarContent" minWidth="240.0" prefWidth="240.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- LOGO SECTION -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <ImageView fitHeight="40.0" fitWidth="160.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../media/icons/logo-equiplink.png" />
                                    </image>
                             <HBox.margin>
                                <Insets top="-4.0" />
                             </HBox.margin>
                                </ImageView>
                            </children>
                            <padding>
                                <Insets top="30.0" />
                            </padding>
                        </HBox>

                        <!-- PROFILE SECTION -->
                        <VBox alignment="CENTER" spacing="15.0">
                            <children>
                                <StackPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="80.0" prefWidth="80.0">
                                    <children>
                                        <ImageView fx:id="ivProfilePic" fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
                                            <image>
                                                <!-- Default placeholder if no user image -->
                                                <Image url="@../../media/profiles/placeholder-profile.png" />
                                            </image>
                                            <clip>
                                                <Circle centerX="60.0" centerY="60.0" radius="60.0" />
                                            </clip>
                                        </ImageView>
                                    </children>
                             <VBox.margin>
                                <Insets />
                             </VBox.margin>
                                </StackPane>
                                <Label fx:id="labelUserName" styleClass="profile-name" text="Doe, John M.">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                             <VBox.margin>
                                <Insets />
                             </VBox.margin>
                                </Label>
                            </children>
                            <padding>
                                <Insets bottom="40.0" top="40.0" />
                            </padding>
                        </VBox>

                        <!-- NAVIGATION SECTION -->
                        <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                            <children>
                                <Button fx:id="btnHome" maxWidth="Infinity" onAction="#showHome" styleClass="menu-button" text="Home">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../../media/icons/icon-home.png" /></ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#showDashboard" styleClass="menu-button, menu-button-active" text="Dashboard">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../../media/icons/icon-dashboard.png" /></ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="btnSettings" maxWidth="Infinity" onAction="#showSettings" styleClass="menu-button" text="Settings">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../../media/icons/icon-settings.png" /></ImageView>
                                    </graphic>
                                </Button>
                                <Button fx:id="btnRecords" maxWidth="Infinity" onAction="#showRecords" styleClass="menu-button" text="Records">
                                    <graphic>
                                        <ImageView fitHeight="26.0" fitWidth="26.0"><Image url="@../../media/icons/icon-records.png" /></ImageView>
                                    </graphic>
                                </Button>
                            </children>
                        </VBox>

                        <!-- LOGOUT SECTION -->
                        <VBox alignment="BOTTOM_CENTER" prefHeight="100.0">
                            <children>
                                <Button fx:id="btnLogout" maxWidth="180.0" onAction="#onClickLogout" prefHeight="45.0" styleClass="logout-button" text="Logout">                                <graphic>
                                        <ImageView fitHeight="20.0" fitWidth="20.0"><Image url="@../../media/icons/icon-logout.png" /></ImageView>
                                    </graphic>
                                </Button>
                            </children>
                            <padding>
                                <Insets bottom="30.0" />
                            </padding>
                        </VBox>
                    </children>
                </VBox>
            </VBox>
        </left>
        <center>
            <StackPane alignment="TOP_LEFT" BorderPane.alignment="CENTER">
                <children>
                    <!-- DYNAMIC CONTENT AREA -->
                    <StackPane fx:id="contentArea" />
               <HBox alignment="CENTER_LEFT" maxHeight="50.0" maxWidth="300.0" prefHeight="50.0" prefWidth="300.0">
                  <children>
      
                          <!-- HAMBURGER BUTTON -->
                          <Button fx:id="btnHamburger" onAction="#toggleSidebar" styleClass="hamburger-button">
                              <graphic>
                                  <ImageView fitHeight="23.0" fitWidth="23.0" pickOnBounds="true" preserveRatio="true">
                                      <image>
                                          <Image url="@../../media/icons/icon-burger-green.png" />
                                      </image>
                                  </ImageView>
                              </graphic>
                        <HBox.margin>
                           <Insets left="15.0" />
                        </HBox.margin>
                          </Button>
                     <Label fx:id="labelShellHeader" styleClass="header-title" text="Header" />
                  </children>
                  <StackPane.margin>
                     <Insets top="15.0" />
                  </StackPane.margin>
               </HBox>
                </children>
            </StackPane>
        </center>
    </BorderPane>


    <!-- LAYER 2: THE GLOBAL SHADOW (Covers everything) -->
    <!-- We set mouseTransparent="false" and pickOnBounds="true" to block clicks to the background -->
    <Pane fx:id="globalShadow" onMouseClicked="#onCloseOverlayRequest" style="-fx-background-color: rgba(0, 0, 0, 0.5);" visible="false" />



    <!-- LAYER 3: THE POPUP CONTAINER (Where FXMLs are injected) -->
    <!-- We use mouseTransparent="true" on the container itself but FALSE on its children
         so the popup is clickable but the empty space around it is not. -->
    <StackPane fx:id="globalOverlayHolder" mouseTransparent="false" pickOnBounds="false" visible="false">
        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>
    </StackPane>

</StackPane>
