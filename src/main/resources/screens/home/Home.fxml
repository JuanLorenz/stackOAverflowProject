<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="650.0" prefWidth="850.0" style="-fx-background-color: white;" stylesheets="@home.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.home.HomeController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
    <children>
        <!-- Page Title -->
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Home">
            <VBox.margin>
                <Insets bottom="20.0" />
            </VBox.margin>
        </Label>

        <!-- User Profile Card -->
        <HBox alignment="CENTER_LEFT" prefHeight="100.0" spacing="20.0" styleClass="gradient-container">
            <padding>
                <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
            </padding>
            <VBox.margin>
                <Insets bottom="30.0" />
            </VBox.margin>
            <children>
                <!-- White Circle for Avatar -->
                <Pane prefHeight="80.0" prefWidth="80.0" styleClass="avatar-circle" />

                <!-- Dynamic Name and Email -->
                <VBox alignment="CENTER_LEFT" spacing="5.0">
                    <children>
                        <Label fx:id="lblName" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="User Name" />
                        <Label fx:id="lblEmail" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: white;" text="Email: placeholder@email.com" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <!-- Borrowed Table Section -->
        <VBox spacing="10.0" VBox.vgrow="ALWAYS">
            <children>
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Borrowed" />

                <VBox styleClass="gradient-container" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="borrowedTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
                            <!-- This forces the columns to stretch perfectly -->
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                            <columns>
                                <!-- The item column stretches to take up all remaining space -->
                                <TableColumn fx:id="itemColumn" prefWidth="550.0" text="Item Details" styleClass="item-column" />

                                <!-- The action column is strictly locked to 120 pixels to prevent it from stealing space -->
                                <TableColumn fx:id="actionColumn" minWidth="120.0" prefWidth="120.0" maxWidth="120.0" text="Action" styleClass="action-column" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</VBox>