<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="750.0" prefWidth="950.0" spacing="15.0" style="-fx-background-color: white;" stylesheets="@HomeUserStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.home.user.HomeUserController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>

        <Label style="-fx-font-size: 14px; -fx-font-style: italic; -fx-text-fill: #888888;" text="Break down your equipment history">
            <VBox.margin><Insets bottom="-10.0" /></VBox.margin>
        </Label>

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="leftArrowBtn" mnemonicParsing="false" onAction="#handleScrollLeft" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 24px; -fx-text-fill: #aaaaaa;" text="◀" />

                <ScrollPane fx:id="categoryScrollPane" fitToHeight="true" fitToWidth="false" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" HBox.hgrow="ALWAYS">
                    <content>
                        <HBox fx:id="cardsContainer" spacing="15.0">
                            <padding>
                                <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
                            </padding>
                        </HBox>
                    </content>
                </ScrollPane>

                <Button fx:id="rightArrowBtn" mnemonicParsing="false" onAction="#handleScrollRight" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 24px; -fx-text-fill: #aaaaaa;" text="▶" />
            </children>
        </HBox>

        <VBox spacing="10.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #222222;" text="Borrowed" />
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="searchField" prefHeight="35.0" prefWidth="300.0" promptText="Search Equipment" style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-border-color: #cccccc;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="categoryComboBox" prefHeight="35.0" prefWidth="150.0" promptText="Category" style="-fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-background-color: white;" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <VBox styleClass="gradient-container" VBox.vgrow="ALWAYS">
            <children>
                <TableView fx:id="borrowedTable" styleClass="custom-table" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="itemColumn" prefWidth="550.0" text="Item Details" styleClass="item-column" />
                        <TableColumn fx:id="actionColumn" maxWidth="120.0" minWidth="120.0" prefWidth="120.0" text="Action" styleClass="action-column" />
                    </columns>
                </TableView>
            </children>
        </VBox>

    </children>
</VBox>