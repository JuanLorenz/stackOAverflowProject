<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" maxHeight="900.0" maxWidth="1600.0" minHeight="225.0" minWidth="400.0" prefHeight="900.0" prefWidth="1600.0" stylesheets="@adminshell.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.userShell.UserShellController">
    <left>
        <!-- SIDEBAR -->
        <VBox fx:id="sidebar" maxWidth="200.0" prefWidth="200.0" spacing="10" styleClass="sidebar">
            <children>
            <HBox alignment="CENTER_LEFT" maxWidth="200.0" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <ImageView fitHeight="150.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/logo-no-text.png" />
                     </image>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </ImageView>
                  <ImageView fitHeight="125.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../images/logo-equiplink.png" />
                     </image>
                  </ImageView>
               </children>
            </HBox>
                <Button maxWidth="Infinity" onAction="#showHome" styleClass="menu-button" text="Home" />
                <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="menu-button, menu-button-active" text="Dashboard" />
                <Button maxWidth="Infinity" onAction="#showSettings" styleClass="menu-button" text="Settings" />
                <Button maxWidth="Infinity" onAction="#showHistory" styleClass="menu-button" text="History">
               <VBox.margin>
                  <Insets bottom="100.0" />
               </VBox.margin></Button>
            <VBox alignment="BOTTOM_LEFT" prefHeight="600.0" prefWidth="100.0">
               <children>
                      <Button maxWidth="150" prefHeight="35.0" prefWidth="200.0" style="-fx-font-size: 14; -fx-background-color: #38BDF8; -fx-text-fill: white; -fx-background-radius: 20;" text="Logout">
                          <VBox.margin>
                        <Insets bottom="20.0" left="20.0" />
                     </VBox.margin>
                      </Button>
               </children>
            </VBox>
            </children>
        </VBox>
    </left>
   <center>
      <StackPane alignment="TOP_LEFT" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>

                <!-- DYNAMIC CONTENT AREA -->
                <StackPane fx:id="contentArea" />
                  <Button fx:id="btnHamburger" onAction="#toggleSidebar" style="-fx-background-color: transparent; -fx-font-size: 20;">
               <graphic>
                  <VBox prefHeight="50.0" prefWidth="50.0">
                     <children>
                        <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../images/icon-burger.png" />
                           </image>
                           <VBox.margin>
                              <Insets top="5.0" />
                           </VBox.margin>
                        </ImageView>
                     </children>
                  </VBox>
               </graphic>
            </Button>
         </children>
      </StackPane>
   </center>
</BorderPane>
