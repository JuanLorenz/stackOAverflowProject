<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@DashboardUserStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.dashboard.DashboardUserController">
    <children>
        <!-- Main Scrollable Content -->
        <VBox prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: white;">
            <children>
                <!-- ORANGE HEADER SECTION -->
                <VBox spacing="15.0" styleClass="orange-header">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label styleClass="dashboard-title" text="Dashboard">
                     <VBox.margin>
                        <Insets left="20.0" />
                     </VBox.margin></Label>
                        <TextField fx:id="tfSearchField" maxWidth="450.0" promptText="Search Equipment" styleClass="search-field">
                     <padding>
                        <Insets left="200.0" />
                     </padding>
                     <VBox.margin>
                        <Insets left="20.0" />
                     </VBox.margin></TextField>
                    </children>
                </VBox>

                <!-- EQUIPMENT GRID SECTION -->
                <ScrollPane fitToWidth="true" styleClass="content-scrollpane" VBox.vgrow="ALWAYS">
                    <content>
                        <TilePane fx:id="equipmentContainer" hgap="25.0" vgap="25.0">
                            <padding>
                                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                        </TilePane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>

        <!-- OVERLAY SHADOW -->
        <Pane fx:id="paneOverlayShadow" onMouseClicked="#onMouseClickExitOverlay" opacity="0.4" style="-fx-background-color: black;" visible="false" />

        <!-- DETAIL POPUP CONTAINER -->
        <VBox fx:id="paneMainContainer" alignment="CENTER" fillWidth="false" visible="false">
            <VBox prefHeight="350.0" prefWidth="450.0" spacing="20" styleClass="detail-card">
                <padding>
                    <Insets bottom="30.0" left="30.0" right="30.0" top="20.0" />
                </padding>
                <children>
                    <HBox alignment="CENTER_RIGHT">
                        <Button fx:id="buttonExitOverlay" onMouseClicked="#onMouseClickExitOverlay" styleClass="exit-button" text="X" />
                    </HBox>
               <HBox alignment="CENTER" prefHeight="350.0" prefWidth="200.0">
                  <children>
                     <ImageView fx:id="equipmentImage" fitHeight="180.0" fitWidth="180.0" pickOnBounds="true" preserveRatio="true">
                        <HBox.margin>
                           <Insets />
                        </HBox.margin></ImageView>
                     <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="200.0">
                        <children>
                                <Label fx:id="labelEquipmentName" styleClass="detail-header" text="Equipment Name" wrapText="true" />
                                <Label fx:id="labelEquipmentDetails" styleClass="detail-body" text="Details go here..." wrapText="true" />
                        </children>
                        <padding>
                           <Insets left="15.0" />
                        </padding>
                     </VBox>
                  </children>
               </HBox>
                    <HBox alignment="CENTER_RIGHT">
                        <Button styleClass="borrow-button" text="Borrow" />
                    </HBox>
                </children>
            </VBox>
        </VBox>
    </children>
</StackPane>
