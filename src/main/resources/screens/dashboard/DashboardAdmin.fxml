<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@DashboardAdminStyle.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.dashboard.DashboardAdminController">
    <children>
        <VBox spacing="25.0" styleClass="main-container">
            <padding>
                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
            </padding>
            <children>
                <!-- Header -->
                <Label styleClass="dashboard-title" />

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <!-- Search Bar (Pill Style) -->
                        <TextField fx:id="textfieldSearchEquipment" promptText="Search Equipment" styleClass="search-bar" HBox.hgrow="ALWAYS" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Add Button (Pill Style) -->
                        <Button fx:id="buttonAddEquipment" onAction="#onAddEquipmentClicked" styleClass="add-button" text="+ Add Equipment" />
                    </children>
                </HBox>

                <!-- EQUIPMENT GRID SECTION -->
                <ScrollPane fitToWidth="true" styleClass="transparent-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <TilePane fx:id="equipmentContainer" hgap="25.0" vgap="25.0">
                            <padding>
                                <Insets bottom="20.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </TilePane>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</StackPane>
