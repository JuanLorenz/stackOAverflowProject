<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane style="-fx-background-color: white;" stylesheets="@DashboardAdminStyle.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.dashboard.DashboardAdminController">
    <children>

        <!-- Main dashboard content -->
        <VBox styleClass="dashboard-scope" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="620.0" prefWidth="1000.0">
            <padding>
                <Insets bottom="30.0" left="20.0" right="30.0" top="30.0" />
            </padding>
            <children>
              <HBox>
                 <children>
                    <Label text="Equipment">
                       <font>
                          <Font name="System Bold" size="18.0" />
                       </font>
                       <HBox.margin>
                          <Insets left="30.0" top="1.0" />
                       </HBox.margin>
                    </Label>
                 </children>
                 <VBox.margin>
                    <Insets />
                 </VBox.margin>
              </HBox>
                <HBox maxHeight="20.0" spacing="40.0" VBox.vgrow="ALWAYS">
                 <children>
                    <TextField fx:id="textfieldSearchEquipment" prefWidth="350.0" promptText="Search Equipment">
                       <font>
                          <Font name="System Italic" size="12.0" />
                       </font>
                       <HBox.margin>
                          <Insets />
                       </HBox.margin>
                    </TextField>
                    <HBox prefHeight="20.0" HBox.hgrow="ALWAYS" />
                    <Button fx:id="buttonAddEquipment" onAction="#onAddEquipmentClicked" alignment="CENTER" mnemonicParsing="false" text="+Add Equipment" />
                 </children>
                 <VBox.margin>
                    <Insets left="30.0" right="10.0" top="50.0" />
                 </VBox.margin>
                </HBox>

                <!-- EQUIPMENT GRID SECTION -->
                <ScrollPane fx:id="scrollpaneEquipment" fitToWidth="true" styleClass="content-scrollpane" VBox.vgrow="ALWAYS">
                    <content>
                        <TilePane fx:id="equipmentContainer" hgap="25.0" maxWidth="1.7976931348623157E308" vgap="25.0">
                        </TilePane>
                    </content>
                 <VBox.margin>
                    <Insets left="30.0" right="10.0" top="20.0" />
                 </VBox.margin>
                </ScrollPane>
            </children>
        </VBox>

        <!-- shadow separating main dashboard and floating screens -->
        <Pane fx:id="paneOverlayShadow" onMouseClicked="#onMouseClickExitOverlay" opacity="0.4" style="-fx-background-color: black;" visible="false" />

        <!-- Add Equipment -->
        <fx:include fx:id="paneAddEquipmentContainer" source="../popup/AddEquipmentPopup.fxml" />

        <!-- Update Equipment -->
        <fx:include fx:id="paneUpdateEquipmentContainer" source="../popup/UpdateEquipmentPopup.fxml"/>
    </children>
</StackPane>
