<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<Pane fx:id="addEquipmentPopUp" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="screens.dashboard.UpdateEquipmentPopupController">
    <children>
        <VBox alignment="CENTER" layoutX="25.0" layoutY="-8.0" prefHeight="408.0" prefWidth="600.0" style="-fx-background-color: white;">
            <children>
                <Label fx:id="labelEquipmentName" prefHeight="35.0" prefWidth="217.0">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <VBox.margin>
                        <Insets top="50.0" />
                    </VBox.margin>
                </Label>
                <HBox prefHeight="238.0" prefWidth="522.0">
                    <children>
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <children>
                                <ImageView fx:id="EquipmentImage" fitHeight="220.0" fitWidth="230.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
                                    <VBox.margin>
                                        <Insets bottom="10.0" top="15.0" />
                                    </VBox.margin>
                                </ImageView>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                                      <Button fx:id="buttonUpdateImage" mnemonicParsing="false" onAction="#onUpdateImgClicked" text="Update Image" textAlignment="JUSTIFY" />
                           </children>
                        </HBox>
                            </children>
                            <HBox.margin>
                                <Insets left="30.0" />
                            </HBox.margin>
                        </VBox>
                        <HBox HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER_LEFT" maxHeight="500.0" maxWidth="300.0" prefHeight="218.0" prefWidth="434.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="labelEquipmentModelNo" text="Model No:">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentSerialNo" text="Serial No:">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentCategory" text="Category:">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </Label>
                                <Label fx:id="labelEquipmentCondition" text="Condition: ">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </Label>
                        <Label fx:id="labelEquipmentAvailable" text="Available: ">
                           <VBox.margin>
                              <Insets bottom="20.0" left="15.0" />
                           </VBox.margin>
                        </Label>
                        <Label text="Updateable: ">
                           <VBox.margin>
                              <Insets bottom="5.0" left="15.0" />
                           </VBox.margin>
                        </Label>
                                <TextField fx:id="updateEquipmentCondition" promptText="Condition">
                                    <VBox.margin>
                                        <Insets bottom="10.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </TextField>
                                <TextField fx:id="updateEquipmentTotalQty" promptText="Total Quantity">
                                    <VBox.margin>
                                        <Insets bottom="20.0" left="15.0" right="15.0" />
                                    </VBox.margin>
                                </TextField>
                            </children>
                            <HBox.margin>
                                <Insets right="30.0" />
                            </HBox.margin>
                     <padding>
                        <Insets left="20.0" right="20.0" />
                     </padding>
                        </VBox>
                    </children>
                    <VBox.margin>
                        <Insets top="30.0" />
                    </VBox.margin>
                </HBox>
                <HBox alignment="BOTTOM_RIGHT" prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <Button fx:id="buttonUpdate" mnemonicParsing="false" onAction="#onUpdateClicked" prefHeight="26.0" prefWidth="77.0" text="Update">
                     <HBox.margin>
                        <Insets right="45.0" />
                     </HBox.margin></Button>
                    </children>
                    <VBox.margin>
                        <Insets bottom="50.0" top="30.0" />
                    </VBox.margin>
                </HBox>
            </children>
        </VBox>
    </children>
</Pane>
